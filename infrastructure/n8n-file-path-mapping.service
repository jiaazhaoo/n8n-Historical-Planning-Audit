[Unit]
Description=n8n file path mapping bridge
After=network.target docker.service

[Service]
Type=simple
# The bridge reads council evidence and writes mapping outputs as the owning
# user. Installed as a system unit it would otherwise run as root, which it has
# no need for.
User=rmsi
Group=rmsi
WorkingDirectory=/env/code/file-matching
Environment=HOME=/home/rmsi
Environment=PATH=/home/rmsi/bin:/home/rmsi/miniconda3/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/rmsi/miniconda3/bin/python /env/code/file-matching/n8n_mapping_service.py --host 0.0.0.0 --port 5680
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
